# Runtime
APP_ENV=staging
LOG_LEVEL=INFO

# SQL Server data warehouse (read-only source)
SOURCE_MSSQL_HOST=sqlserver.example.internal
SOURCE_MSSQL_PORT=1433
SOURCE_MSSQL_DATABASE=warehouse
SOURCE_MSSQL_USER=replace_me
SOURCE_MSSQL_PASSWORD=replace_me
SOURCE_MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# PostgreSQL application database (ETL and recommendation destination)
TARGET_POSTGRES_HOST=postgres.example.internal
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_DATABASE=recommendation_staging
TARGET_POSTGRES_USER=replace_me
TARGET_POSTGRES_PASSWORD=replace_me
TARGET_POSTGRES_SSLMODE=require

# Association-mining defaults
MIN_SUPPORT_RATIO=0.001
MIN_CONFIDENCE=0.0
MIN_LIFT=1.0
